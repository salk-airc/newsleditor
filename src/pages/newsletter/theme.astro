---
import Newsletter from "../../layouts/Newsletter.astro";
import { canEdit } from "../../lib/newsletter";
import { BANNER_HEIGHT, FONTS, PALETTES } from "../../plugins/newsletter/theme.ts";

// The newsletter's theme: name, logo, colors, font and glow banner, with the
// email previewed live as they change (src/scripts/theme-editor.ts). Saved
// through the newsletter plugin's theme-update route, which refuses a theme
// that would be hard to read. Claude edits the same theme through the
// plugin's theme tools. Same gate as the editor.

export const prerender = false;

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect(`/_emdash/admin/login?redirect=${encodeURIComponent(Astro.url.pathname)}`);
}
const allowed = canEdit(user);
if (!allowed) Astro.response.status = 403;
Astro.response.headers.set("Cache-Control", "private, no-store");

const colors = [
  ["page", "Page", "The whole email's background. Keep it light."],
  ["ink", "Text", "Headings and body text. Near-black, so phone dark modes turn it white."],
  ["muted", "Muted text", "Dates, captions, the tagline."],
  ["accent", "Accent", "Links, bullets, the end of the name, buttons, the first glow."],
  ["accent2", "Second accent", "The wordmark, the second glow, the end of the rules."],
  ["rule", "Lines", "The thin line above the signature."],
] as const;
---

<Newsletter title="Theme">
  {/* So each font is listed in its own face. */}
  {Object.values(FONTS).map((f) => f.link && <link rel="stylesheet" href={f.link} />)}
  <section class="theme shell">
    <h1 class="display theme__title">Theme</h1>
    {
      allowed ? (
        <div class="theme__grid" data-theme-editor>
          <form class="theme__form" data-form>
            <p class="theme__intro">
              How the newsletter looks. Changes show in the preview right away and apply to every draft once saved. You
              can also ask Claude to change it.
            </p>

            <fieldset>
              <legend>Name</legend>
              <label>
                Name <input name="name" required maxlength="60" />
              </label>
              <label>
                In the accent color
                <select data-accent-words />
                <span class="theme__hint">The end of the name can stand out, like “Field <em>Notes</em>”.</span>
              </label>
              <label>
                Footer line <input name="footer" maxlength="160" placeholder="The Lab · Salk Institute" />
                <span class="theme__hint">Small print at the very bottom.</span>
              </label>
            </fieldset>

            <fieldset>
              <legend>Logo</legend>
              <div class="theme__logo">
                <img data-logo-img alt="" hidden />
                <span data-logo-none>No logo</span>
                <label class="theme__button">
                  Upload… <input type="file" accept="image/png,image/jpeg,image/gif" data-logo-file hidden />
                </label>
                <button type="button" class="theme__button" data-logo-clear>Remove</button>
              </div>
              <p class="theme__hint">
                A transparent PNG works best; it's shown 40px tall. Not SVG: Gmail and Outlook don't show SVG images.
              </p>
              <label>
                Wordmark <input name="wordmark" maxlength="24" placeholder="LAB" />
                <span class="theme__hint">A short word beside the logo, in the second accent.</span>
              </label>
              <label>
                Tagline <textarea name="tagline" rows="2" maxlength="120" placeholder={"Salk Institute\nfor Biological Studies"} />
                <span class="theme__hint">Beside the wordmark. A line break makes two lines.</span>
              </label>
            </fieldset>

            <fieldset>
              <legend>Colors</legend>
              <div class="theme__palettes" role="group" aria-label="Suggested colors">
                <button type="button" class="theme__palette" data-palette="logo" hidden>
                  <span class="theme__swatches" data-logo-swatches />
                  From the logo
                </button>
                {
                  PALETTES.map((p, i) => (
                    <button type="button" class="theme__palette" data-palette={i}>
                      <span class="theme__swatches">
                        {[p.colors.accent, p.colors.accent2, p.colors.page].map((c) => (
                          <span style={`background:${c}`} />
                        ))}
                      </span>
                      {p.name}
                    </button>
                  ))
                }
              </div>
              <p class="theme__hint">Start from one of these, then fine-tune any color below.</p>
              {
                colors.map(([key, label, hint]) => (
                  <label class="theme__color">
                    <input type="color" data-color={key} />
                    <span>
                      <span class="theme__color-name">{label}</span>
                      <span class="theme__hint">{hint}</span>
                    </span>
                    <input class="theme__hex" data-hex={key} maxlength="7" spellcheck="false" aria-label={`${label} hex`} />
                  </label>
                ))
              }
            </fieldset>

            <fieldset>
              <legend>Type and lines</legend>
              <label>
                Font
                <select name="font" class="theme__font-select" data-font>
                  {(["Sans serif", "Serif"] as const).map((group) => (
                    <optgroup label={group}>
                      {Object.entries(FONTS)
                        .filter(([, f]) => f.group === group)
                        .map(([key, f]) => (
                          <option value={key} style={`font-family:${f.stack}`}>
                            {f.label}
                          </option>
                        ))}
                    </optgroup>
                  ))}
                </select>
                <span class="theme__hint" data-font-elsewhere />
              </label>
              <label class="theme__check">
                <input type="checkbox" data-rules-on /> Lines under the name and headings
              </label>
            </fieldset>

            <fieldset>
              <legend>Banner</legend>
              <label>
                Across the top
                <select data-banner-style>
                  <option value="glow">A glow in the accent colors</option>
                  <option value="image">Your own picture</option>
                  <option value="none">No banner</option>
                </select>
              </label>
              <div class="theme__banner-part" data-banner-part="glow">
                <label>
                  Glow strength <input type="range" min="0" max="100" step="5" data-banner-strength />
                </label>
                <div class="theme__pattern">
                  <span>Pattern <span class="theme__hint" data-banner-pattern-name /></span>
                  <button type="button" class="theme__button" data-banner-shuffle>Shuffle</button>
                  <button type="button" class="theme__button" data-banner-classic>Classic</button>
                </div>
                <label>
                  Height <input
                    type="range"
                    min={BANNER_HEIGHT.min}
                    max={BANNER_HEIGHT.max}
                    step="5"
                    data-banner-height
                  />
                  <span class="theme__hint">You can also drag the bottom of the banner in a draft's preview.</span>
                </label>
              </div>
              <div class="theme__banner-part" data-banner-part="image">
                <div class="theme__logo">
                  <img data-banner-img alt="" hidden />
                  <span data-banner-none>No picture yet</span>
                  <label class="theme__button">
                    Upload… <input type="file" accept="image/png,image/jpeg,image/gif" data-banner-file hidden />
                  </label>
                </div>
                <p class="theme__hint">A wide PNG or JPEG, about 1280 pixels across. It's shown the full width, at its own shape.</p>
              </div>
              <label class="theme__check" data-banner-part="glow image">
                <input type="checkbox" data-banner-full /> Across the whole email, edge to edge
              </label>
            </fieldset>

            <ul class="theme__problems" data-problems aria-live="polite" />

            <p class="theme__actions">
              <button type="submit" class="theme__save" data-save>Save theme</button>
              <button type="button" class="theme__button" data-reset>Undo changes</button>
              <span class="theme__status" data-status role="status" />
            </p>
          </form>

          <div class="theme__preview">
            <div class="theme__preview-bar">
              <span class="label">Preview</span>
              <label class="theme__check">
                <input type="checkbox" data-dark /> Rough dark mode
              </label>
            </div>
            <p class="theme__subject" data-subject />
            <iframe class="theme__frame" data-preview title="Email preview" sandbox="allow-same-origin" />
          </div>
        </div>
      ) : (
        <p class="prose">
          You're signed in as {user.email}, which can't change the theme. That's for Editors and Admins; ask an Admin
          to change your role in <a href="/_emdash/admin">the admin</a>.
        </p>
      )
    }
  </section>
</Newsletter>

<script>
  import { startThemeEditor } from "../../scripts/theme-editor.ts";

  const root = document.querySelector<HTMLElement>("[data-theme-editor]");
  if (root) startThemeEditor(root);
</script>

<style>
  .theme {
    max-width: 82rem;
    padding-block: clamp(2rem, 6vh, 3.5rem) 4rem;
  }

  .theme__title {
    font-size: clamp(2rem, 5vw, 2.8rem);
    margin-bottom: 1.5rem;
  }

  .theme__grid {
    display: grid;
    grid-template-columns: minmax(0, 24rem) minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
  }

  .theme__intro,
  .theme__hint {
    color: var(--ink-soft);
  }

  .theme__hint {
    display: block;
    font-size: 0.8rem;
  }

  fieldset {
    border: 0;
    border-top: 1px solid var(--rule);
    margin: 1.25rem 0 0;
    padding: 1rem 0 0;
    display: grid;
    gap: 0.75rem;
  }

  legend {
    font-weight: 600;
    padding: 0;
  }

  label {
    display: grid;
    gap: 0.25rem;
    font-size: 0.9rem;
  }

  input:not([type="color"], [type="checkbox"], [type="range"], [type="file"]),
  textarea,
  select {
    font: inherit;
    padding: 0.4rem 0.5rem;
    border: 1px solid var(--rule-strong, var(--rule));
    border-radius: 6px;
    background: transparent;
    color: inherit;
  }

  .theme__logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .theme__logo img {
    height: 40px;
    width: auto;
  }

  .theme__color {
    grid-template-columns: 2.4rem minmax(0, 1fr) 5.5rem;
    align-items: center;
    gap: 0.6rem;
  }

  .theme__color input[type="color"] {
    width: 2.4rem;
    height: 2.4rem;
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: none;
    cursor: pointer;
  }

  .theme__banner-part {
    display: grid;
    gap: 0.75rem;
  }

  [data-banner-part][hidden] {
    display: none;
  }

  .theme__pattern {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
  }

  .theme__pattern > span {
    margin-right: auto;
  }

  .theme__palettes {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10.5rem, 1fr));
    gap: 0.5rem;
  }

  .theme__palette {
    font: inherit;
    font-size: 0.85rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: transparent;
    color: inherit;
    cursor: pointer;
    text-align: left;
  }

  .theme__palette[hidden] {
    display: none;
  }

  .theme__palette:hover {
    border-color: var(--ink-soft);
  }

  .theme__palette[aria-pressed="true"] {
    border-color: var(--blue);
    box-shadow: inset 0 0 0 1px var(--blue);
  }

  /* A customizable select where the browser has it (Chrome), so each font is
     listed in its own face; elsewhere an ordinary dropdown of names. */
  .theme__font-select,
  .theme__font-select::picker(select) {
    appearance: base-select;
  }

  .theme__font-select::picker(select) {
    max-height: 22rem;
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: var(--stone-sunk);
    color: var(--ink);
  }

  .theme__font-select option {
    font-size: 1rem;
    padding: 0.35rem 0.6rem;
  }

  .theme__font-select optgroup {
    font: 600 0.75rem var(--font-body);
    color: var(--ink-soft);
  }

  .theme__swatches {
    display: flex;
    flex: none;
  }

  /* :global: the logo's swatches are made by the script. */
  .theme__swatches :global(span) {
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, 0.15);
  }

  .theme__swatches :global(span + span) {
    margin-left: -0.3rem;
  }

  .theme__color-name {
    font-weight: 500;
  }

  .theme__hex {
    font-family: var(--font-mono, monospace);
    font-size: 0.85rem;
  }

  .theme__check {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .theme__problems {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
    font-size: 0.85rem;
  }

  .theme__problems li {
    padding: 0.5rem 0.7rem;
    border-radius: 6px;
    border-left: 3px solid;
  }

  .theme__problems [data-kind="error"] {
    border-color: #b3261e;
    background: rgba(179, 38, 30, 0.08);
  }

  .theme__problems [data-kind="warning"] {
    border-color: #b07a00;
    background: rgba(176, 122, 0, 0.08);
  }

  .theme__actions {
    margin-top: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .theme__save,
  .theme__button {
    font: inherit;
    font-size: 0.9rem;
    border-radius: 6px;
    padding: 0.45rem 0.9rem;
    cursor: pointer;
    display: inline-block;
  }

  .theme__save {
    font-weight: 600;
    border: 0;
    background: var(--blue);
    color: #fff;
  }

  .theme__save:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .theme__button {
    border: 1px solid var(--rule);
    background: transparent;
    color: inherit;
  }

  .theme__status {
    font-size: 0.85rem;
    color: var(--ink-soft);
  }

  .theme__preview {
    position: sticky;
    top: 1rem;
  }

  .theme__preview-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .theme__subject {
    font-size: 0.85rem;
    color: var(--ink-soft);
    margin: 0 0 0.5rem;
  }

  .theme__frame {
    width: 100%;
    height: min(80vh, 60rem);
    border: 1px solid var(--rule);
    border-radius: 10px;
    background: #fff;
  }

  /* A full inversion, roughly what a phone's dark mode does to an email:
     text and backgrounds flip, images don't (they're flipped back inside). */
  .theme__frame.is-dark {
    filter: invert(1) hue-rotate(180deg);
  }

  @media (max-width: 60rem) {
    .theme__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .theme__preview {
      position: static;
    }
  }
</style>
