---
import Base from "../../../layouts/Base.astro";
import { canEdit, getEditions } from "../../../lib/newsletter";

// The edition editor: markdown on the left, the real email, Slack post and
// archive page rendered live on the right. Everything after the
// login check happens in the browser, against EmDash's content API with the
// editor's own session, so EmDash's permissions and revisions apply as they
// do in the admin.

export const prerender = false;

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect(`/_emdash/admin/login?redirect=${encodeURIComponent(Astro.url.pathname)}`);
}
const allowed = canEdit(user);
if (!allowed) Astro.response.status = 403;

const slug = Astro.params.slug ?? "";

// The editor is for drafting. A published edition is in the archive, and
// isn't edited here.
const [publishedEditions, draftEditions] = allowed ? await Promise.all([getEditions(), getEditions("draft")]) : [[], []];
const published = publishedEditions.some((e) => e.slug === slug);

// Where "this week" starts in the Inbox tab: the date of the edition before
// this one, sent or not. Items added before it are earlier weeks' leftovers.
const editionDate = new Date(`${slug}T12:00:00.000Z`);
const previous = [...publishedEditions, ...draftEditions]
  .filter((e) => e.date < editionDate)
  .sort((a, b) => b.date.getTime() - a.date.getTime())[0];
const inboxSince = previous?.date.toISOString() ?? "";
---

<Base title={`Edit ${slug}`}>
  {
    allowed && published ? (
      <main class="denied shell">
        <h1 class="display">Already published</h1>
        <p class="prose">
          {slug} is in the archive: <a href={`/newsletter/${slug}`}>read it there</a>. The editor is for editions that
          aren't out yet; see the <a href="/newsletter/edit">drafts</a>.
        </p>
      </main>
    ) : allowed ? (
      <div class="editor" data-slug={slug} data-user={user.name || user.email} data-inbox-since={inboxSince}>
        <header class="bar">
          <a class="bar__back label" href="/newsletter/edit">
            ← Editions
          </a>
          <h1 class="bar__title" data-title>
            {slug}
          </h1>
          <ul class="people" data-people aria-label="Editing now" />
          <p class="bar__status" data-status role="status">
            Loading…
          </p>
        </header>

        <section class="pane pane--source" aria-label="Markdown">
          <div class="tabs" role="tablist" aria-label="Which text">
            <button class="tab" role="tab" aria-selected="true" data-doc="body">
              Email
            </button>
            <button class="tab" role="tab" aria-selected="false" data-doc="slack">
              Slack post
            </button>
          </div>
          <div class="imagebar" data-imagebar hidden>
            <span class="imagebar__label">Image</span>
            <div class="imagebar__sizes" role="group" aria-label="Size">
              <button type="button" data-size="200">S</button>
              <button type="button" data-size="320">M</button>
              <button type="button" data-size="440">L</button>
              <button type="button" data-size="">Full</button>
            </div>
            <label class="imagebar__width">
              <input type="range" min="120" max="560" step="10" data-image-width aria-label="Width in pixels" />
              <output data-image-width-out />
            </label>
            <div class="imagebar__frames" role="group" aria-label="Frame">
              <button type="button" data-frame="accent" title="Accent frame" aria-label="Accent frame" />
              <button type="button" data-frame="accent2" title="Second accent frame" aria-label="Second accent frame" />
              <button type="button" data-frame="grey" title="Grey frame" aria-label="Grey frame" />
              <button type="button" data-frame="none" title="No frame" aria-label="No frame" />
            </div>
            <input class="imagebar__caption" type="text" data-image-caption placeholder="Caption (also the alt text)" aria-label="Caption" />
            <button type="button" class="imagebar__edit" data-image-edit>Crop &amp; rotate</button>
          </div>
          <div class="source" data-source />
          <ul class="checks" data-checks aria-live="polite" />
        </section>

        <dialog class="cropper" data-cropper aria-label="Crop and rotate">
          <div class="cropper__stage" data-crop-stage>
            <canvas data-crop-canvas />
            <div class="cropper__box" data-crop-box hidden />
          </div>
          <p class="cropper__hint">Drag over the image to crop. Saving uploads an edited copy; the original stays in the media library.</p>
          <div class="cropper__actions">
            <button type="button" data-crop-rotate="-90">Rotate left</button>
            <button type="button" data-crop-rotate="90">Rotate right</button>
            <button type="button" data-crop-reset>Reset</button>
            <span class="cropper__spacer" />
            <button type="button" data-crop-cancel>Cancel</button>
            <button type="button" class="cropper__save" data-crop-save>Save</button>
          </div>
        </dialog>

        <section class="pane pane--preview" aria-label="Preview">
          <div class="tabs" role="tablist" aria-label="Preview">
            <button class="tab" role="tab" aria-selected="true" data-view="email">
              Email
            </button>
            <button class="tab" role="tab" aria-selected="false" data-view="slack">
              Slack
            </button>
            <button class="tab" role="tab" aria-selected="false" data-view="web">
              Archive page
            </button>
            <button class="tab" role="tab" aria-selected="false" data-view="inbox">
              Inbox <span class="tab__count" data-inbox-badge />
            </button>
            <button class="copy" data-copy type="button">
              Copy for Outlook
            </button>
          </div>
          <iframe class="preview" data-preview title="Preview" sandbox="allow-same-origin allow-popups allow-popups-to-escape-sandbox" />
          <div class="inbox" data-inbox hidden>
            <p class="inbox__hint">
              What the team saved for the newsletter. To add something, tell Claude “add this to the newsletter”.
            </p>
            <h2 class="inbox__head">This week</h2>
            <ul class="inbox__list" data-inbox-current />
            <div data-inbox-earlier hidden>
              <h2 class="inbox__head">Earlier</h2>
              <p class="inbox__hint">Saved before the last edition and not used yet.</p>
              <ul class="inbox__list inbox__list--earlier" data-inbox-earlier-list />
            </div>
          </div>
        </section>
      </div>
    ) : (
      <main class="denied shell">
        <h1 class="display">Editors only</h1>
        <p class="prose">
          You're signed in as {user.email}, which can't edit editions. Editing is for Editors and Admins; ask an Admin
          to change your role in <a href="/_emdash/admin">the admin</a>.
        </p>
      </main>
    )
  }
</Base>

<script>
  import { startEditor } from "../../../scripts/edition-editor.ts";

  const root = document.querySelector<HTMLElement>(".editor");
  if (root) startEditor(root);
</script>

<style>
  .editor {
    height: 100dvh;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-rows: auto minmax(0, 1fr);
    grid-template-areas:
      "bar bar"
      "source preview";
    /* Two rounded panels on a slightly darker frame, with a gap between. */
    gap: 0 0.375rem;
    padding: 0 0.375rem 0.375rem;
    background: var(--stone-sunk);
  }

  .bar {
    grid-area: bar;
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    padding: 0.6rem 0.5rem;
  }

  .bar__back {
    color: var(--ink-soft);
    text-decoration: none;
  }

  .bar__back:hover {
    color: var(--ink);
  }

  .bar__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .people {
    list-style: none;
    margin: 0 0 0 auto;
    padding: 0;
    display: flex;
    gap: 0.35rem;
  }

  .people :global(li) {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    color: #fff;
    background: var(--who, var(--blue));
    white-space: nowrap;
  }

  .bar__status {
    font-size: 0.85rem;
    color: var(--ink-soft);
    white-space: nowrap;
  }

  .bar__status[data-state="error"] {
    color: #b3261e;
  }

  .pane {
    display: flex;
    flex-direction: column;
    min-height: 0;
    background: var(--stone);
    border: 1px solid var(--rule);
    border-radius: 8px;
    /* Rounds the preview frame and the editor with the panel. */
    overflow: hidden;
  }

  .pane--source {
    grid-area: source;
  }

  .pane--preview {
    grid-area: preview;
  }

  .tabs {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--rule);
    /* Labels stay on one line; a narrow pane scrolls the bar sideways. */
    overflow-x: auto;
    scrollbar-width: none;
  }

  .tab,
  .copy {
    font: inherit;
    font-size: 0.85rem;
    border: 0;
    border-radius: 6px;
    padding: 0.35rem 0.7rem;
    cursor: pointer;
    background: none;
    color: var(--ink-soft);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .tab:hover {
    color: var(--ink);
  }

  .tab[aria-selected="true"] {
    background: var(--stone-sunk);
    color: var(--ink);
    font-weight: 600;
  }

  .copy {
    margin-left: auto;
    background: var(--blue);
    color: #fff;
    font-weight: 600;
  }

  .copy:hover {
    filter: brightness(1.1);
  }

  .copy[hidden] {
    display: none;
  }

  /* Shown while the cursor is on an image in the markdown. */
  .imagebar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    padding: 0.45rem 0.75rem;
    border-bottom: 1px solid var(--rule);
    font-size: 0.8rem;
    color: var(--ink-soft);
  }

  .imagebar[hidden] {
    display: none;
  }

  .imagebar__label {
    font-weight: 600;
    color: var(--ink);
  }

  .imagebar__sizes {
    display: flex;
    gap: 0.15rem;
  }

  .imagebar button,
  .cropper button {
    font: inherit;
    font-size: 0.8rem;
    border: 1px solid var(--rule-strong);
    border-radius: 6px;
    padding: 0.2rem 0.55rem;
    cursor: pointer;
    background: var(--stone);
    color: var(--ink);
  }

  .imagebar button:hover,
  .cropper button:hover {
    background: var(--stone-sunk);
  }

  .imagebar button[aria-pressed="true"] {
    background: var(--blue);
    border-color: var(--blue);
    color: #fff;
  }

  .imagebar__frames {
    display: flex;
    gap: 0.3rem;
  }

  /* Swatches: the frame colour, set from FRAME_COLORS by the script; "none"
     is the editor background with a slash through it. */
  .imagebar .imagebar__frames button {
    width: 1.35rem;
    height: 1.35rem;
    padding: 0;
    border-radius: 50%;
    background: var(--swatch, linear-gradient(135deg, transparent 46%, var(--rule-strong) 46% 54%, transparent 54%));
  }

  .imagebar .imagebar__frames button[aria-pressed="true"] {
    background: var(--swatch, linear-gradient(135deg, transparent 46%, var(--rule-strong) 46% 54%, transparent 54%));
    border-color: var(--blue);
    box-shadow: 0 0 0 2px var(--blue);
  }

  .imagebar__width {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .imagebar__width output {
    min-width: 3.5em;
    font-variant-numeric: tabular-nums;
  }

  .imagebar__caption {
    flex: 1;
    min-width: 10rem;
    font: inherit;
    font-size: 0.8rem;
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--rule-strong);
    border-radius: 6px;
    background: var(--stone);
    color: var(--ink);
  }

  .cropper {
    width: min(56rem, calc(100vw - 2rem));
    padding: 1rem;
    border: 1px solid var(--rule);
    border-radius: 12px;
    background: var(--stone);
    color: var(--ink);
  }

  .cropper::backdrop {
    background: rgb(0 0 0 / 0.55);
  }

  .cropper__stage {
    position: relative;
    display: flex;
    justify-content: center;
    background: var(--stone-sunk);
    border-radius: 8px;
    padding: 0.5rem;
    user-select: none;
    touch-action: none;
  }

  .cropper__stage canvas {
    display: block;
    max-width: 100%;
    max-height: 65vh;
    cursor: crosshair;
  }

  .cropper__box {
    position: absolute;
    border: 2px solid #fff;
    box-shadow: 0 0 0 9999px rgb(0 0 0 / 0.45);
    pointer-events: none;
  }

  .cropper__box[hidden] {
    display: none;
  }

  .cropper__hint {
    font-size: 0.8rem;
    color: var(--ink-soft);
    margin: 0.6rem 0;
  }

  .cropper__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .cropper__spacer {
    flex: 1;
  }

  .cropper .cropper__save {
    background: var(--blue);
    border-color: var(--blue);
    color: #fff;
    font-weight: 600;
  }

  .source {
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }

  .source :global(.cm-editor) {
    height: 100%;
    font-size: 14px;
  }

  .source :global(.cm-scroller) {
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    line-height: 1.6;
  }

  .source :global(.cm-content) {
    padding: 1rem 0;
  }

  .source :global(.cm-line) {
    padding: 0 1.25rem;
  }

  .tab__count:not(:empty) {
    margin-left: 0.2rem;
    padding: 0 0.4rem;
    border-radius: 999px;
    font-size: 0.75rem;
    background: var(--blue);
    color: #fff;
  }

  .inbox {
    flex: 1;
    min-height: 0;
    overflow: auto;
    padding: 1rem 1.25rem 2rem;
  }

  .inbox[hidden],
  .preview[hidden] {
    display: none;
  }

  .inbox__hint {
    font-size: 0.85rem;
    color: var(--ink-soft);
  }

  .inbox__head {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    margin: 1.25rem 0 0.5rem;
  }

  /* Plain bullets, like the old inbox.md: the link, then the note. */
  .inbox__list {
    margin: 0;
    padding-left: 1.1rem;
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .inbox__list :global(li + li) {
    margin-top: 0.5rem;
  }

  .inbox__list :global(li::marker) {
    color: var(--green-ink);
  }

  .inbox__list :global(.inbox__empty) {
    list-style: none;
    margin-left: -1.1rem;
    color: var(--ink-soft);
  }

  .inbox__list :global(a) {
    color: var(--ink);
    font-weight: 600;
  }

  .inbox__list :global(.inbox__note) {
    white-space: pre-wrap;
  }

  /* Leftovers read quieter than this week's items. */
  .inbox__list--earlier {
    opacity: 0.75;
  }

  [data-inbox-earlier][hidden] {
    display: none;
  }

  .inbox__list :global(.inbox__who) {
    color: var(--ink-soft);
    font-size: 0.8rem;
  }

  .checks {
    list-style: none;
    margin: 0;
    padding: 0.5rem 1.25rem;
    border-top: 1px solid var(--rule);
    font-size: 0.8rem;
    color: var(--ink-soft);
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
  }

  .checks :global(.warn) {
    color: #8a5a00;
  }

  .preview {
    flex: 1;
    width: 100%;
    border: 0;
    background: #fff;
  }

  .denied {
    padding-block: 4rem;
  }

  /* Phones get one column: the markdown, with the preview under it. */
  @media (max-width: 52rem) {
    .editor {
      height: auto;
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto 70dvh 90dvh;
      grid-template-areas: "bar" "source" "preview";
      gap: 0.375rem;
    }
  }
</style>
